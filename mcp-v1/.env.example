# Shared .env for all MCP connectors.
# IMPORTANT: values must be PLAIN strings — no quotes, no brackets, no markdown.
#   GOOD:  JIRA_BASE_URL=https://foo.atlassian.net
#   BAD:   JIRA_BASE_URL='https://foo.atlassian.net'   <- quotes become part of the value
#   BAD:   JIRA_BASE_URL=[https://foo.atlassian.net](https://foo.atlassian.net)
# After editing this file, restart the server — .env is only read at startup.

# --- github.py / github_enterprise.py ------------------------------------
GITHUB_TOKEN=
GITHUB_ENTERPRISE_URL=https://github.yourcompany.com
GITHUB_ENTERPRISE_TOKEN=

# --- testrail.py ---------------------------------------------------------
TESTRAIL_URL=https://yourcompany.testrail.io
TESTRAIL_USER=you@company.com
TESTRAIL_API_KEY=

# --- postgresql.py -------------------------------------------------------
PG_HOST=ep-long-heart-b4l5jfws-pooler.c-6.us-east-2.aws.neon.tech
PG_PORT=5432
PG_DATABASE=neondb
PG_USER=neondb_owner
PG_PASSWORD=npg_YoqJ87jKcFQR

# --- jira.py -------------------------------------------------------------
JIRA_BASE_URL=https://duraiucevit.atlassian.net
JIRA_EMAIL=duraiucevit@gmail.com
