# --- sharepoint.py / onedrive.py -----------------------------------------
# Register an app at https://portal.azure.com -> App registrations
# Grant: Sites.ReadWrite.All (SharePoint), Files.ReadWrite.All (OneDrive)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_SITE_URL=https://yourcompany.sharepoint.com/sites/yoursite

# --- confluence.py -------------------------------------------------------
CONFLUENCE_URL=https://yourcompany.atlassian.net
CONFLUENCE_EMAIL=you@company.com
CONFLUENCE_API_TOKEN=

# --- teams.py ------------------------------------------------------------
# Same Azure app as SharePoint/OneDrive — add ChannelMessage.Send,
# Chat.ReadWrite, Team.ReadBasic.All scopes.
# AZURE_TENANT_ID / AZURE_CLIENT_ID / AZURE_CLIENT_SECRET already above.
TEAMS_USER_ID=

# --- outlook.py ----------------------------------------------------------
# Same Azure app — add Mail.ReadWrite, Mail.Send, Calendars.ReadWrite.
# AZURE_TENANT_ID / AZURE_CLIENT_ID / AZURE_CLIENT_SECRET already above.
OUTLOOK_USER_ID=

# --- files.py (PDF, Word, Excel, CSV, Markdown, PPT, Plain text,
#               Local folders, Windows file system) ------------------------
# No credentials needed — this connector works on local file paths you
# pass as arguments. Set a default root folder to restrict access:
FILES_ROOT_DIR=C:\Users\<Username>\Documents
